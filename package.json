{
  "name": "qipath-pro",
  "version": "10.4.7",
  "private": true,
  "description": "Chinese metaphysics timing companion — almanac, Bazi, Zi Wei Dou Shu, Qimen, Yijing, Feng Shui",
  "scripts": {
    "sync": "cap sync android",
    "open": "cap open android",
    "apk": "cd android && ./gradlew assembleDebug",
    "release": "node tools/release.js",
    "build:es5": "babel www/js/qpdata.js --config-file ./.babelrc.json -o www/js/qpdata.js",
    "verify": "node -e \"require('fs').readdirSync('www/js').filter(f=>f.endsWith('.js')).forEach(f=>{require('child_process').execSync('node --check www/js/'+f);console.log('ok '+f)})\"",
    "setup:sdk": "node tools/setup-sdk.js",
    "calibrate": "node tools/calibrate-entropy.js"
  },
  "dependencies": {
    "@capacitor-community/speech-recognition": "6.0.1",
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "6.0.3",
    "@capacitor/core": "^6.2.2",
    "@capacitor/filesystem": "^6.0.4",
    "@capacitor/local-notifications": "6.1.3",
    "@capacitor/share": "^6.0.4"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@capacitor/cli": "^8.4.3",
    "jsdom": "^30.0.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
